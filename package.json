{
  "name": "saucedemo-playwright-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade Playwright + TypeScript test framework for SauceDemo, built and maintained with agentic AI workflows (Claude Code).",
  "author": "Marko Vukobrat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vukobrat/saucedemo-playwright-ai.git"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "test": "playwright test",
    "test:local": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "zod": "4.6.7"
  }
}
