{
  "name": "saucedemo-playwright-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade Playwright + TypeScript test framework for SauceDemo, built and maintained with agentic AI workflows (Claude Code).",
  "author": "Marko Vukobrat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vukobrat/saucedemo-playwright-ai.git"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "test": "playwright test",
    "test:local": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:persona": "playwright test --grep @persona",
    "test:a11y": "playwright test --project=a11y",
    "test:api": "playwright test --project=api",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots=all",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:docker": "docker run --rm --init --ipc=host -e SAUCE_PASSWORD -e BASE_URL -v \"$PWD/playwright-report:/app/playwright-report\" -v \"$PWD/test-results:/app/test-results\" saucedemo-playwright-ai",
    "docker:build": "docker build -t saucedemo-playwright-ai .",
    "report": "playwright show-report",
    "check:versions": "node scripts/check-playwright-version.mjs",
    "agent:trace": "node scripts/agent-trace.mjs",
    "agent:triage": "node scripts/agent-triage.mjs",
    "agent:review": "node scripts/agent-review.mjs",
    "context:budget": "node scripts/context-budget.mjs",
    "mcp:qa": "tsx src/mcp/qa-server.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "zod": "4.6.7"
  }
}
