{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__playwright__*",
      "Bash(npm run *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)"
    ],
    "ask": ["Edit(/.claude/settings.json)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
