# Dependencies
node_modules/

# Playwright artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Saved login sessions (storageState) - regenerated by the setup project
/.auth/

# Environment files hold secrets; only the template is committed
.env
.env.*
!.env.example

# Claude Code personal files (shared settings live in .claude/settings.json)
.claude/settings.local.json
CLAUDE.local.md

# Playwright MCP session output (snapshots, console logs)
/.playwright-mcp/

# Headless agent run traces (stream-json); may contain local paths and session ids
/traces/

# Personal mentoring brief (local only)
/docs/mentor-prompt.md

# OS and editors
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
