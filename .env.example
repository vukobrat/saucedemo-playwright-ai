# Copy to .env and fill in the values. .env is gitignored.
# Real environment variables (shell, CI secrets) always take precedence over this file.

# Target application. Optional, defaults to the public SauceDemo site.
BASE_URL=https://www.saucedemo.com

# Password shared by all SauceDemo demo users (it is shown on the login page). Required.
SAUCE_PASSWORD=

# Set to true to disable knownBug() markers and see the real failures. Optional.
EXPOSE_KNOWN_BUGS=false

# API test layer (DummyJSON). Required only for the api project (npm run test:api).
# The public demo account is documented at https://dummyjson.com/docs/auth.
API_BASE_URL=https://dummyjson.com
API_USERNAME=
API_PASSWORD=

# Local machines where Playwright's bundled browsers are unsupported (e.g. macOS 12):
# run the chromium project on installed Google Chrome and turn video off (no ffmpeg build).
# Leave both unset in CI and Docker.
# BROWSER_CHANNEL=chrome
# RECORD_VIDEO=false
