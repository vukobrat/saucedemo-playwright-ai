# Copy to .env and fill in the values. .env is gitignored.
# Real environment variables (shell, CI secrets) always take precedence over this file.

# Target application. Optional, defaults to the public SauceDemo site.
BASE_URL=https://www.saucedemo.com

# Password shared by all SauceDemo demo users (it is shown on the login page). Required.
SAUCE_PASSWORD=

# Set to true to disable knownBug() markers and see the real failures. Optional.
EXPOSE_KNOWN_BUGS=false
